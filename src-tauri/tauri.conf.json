{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Promediatum",
  "version": "1.0.0",
  "identifier": "com.sxnnyside.promediatum.desktop",
  "build": {
    "frontendDist": "../public/build",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "windows": [
      {
        "title": "Promediatum",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/frankenphp"
    ],
    "resources": [
      "../app",
      "../bootstrap",
      "../config",
      "../database",
      "../lang",
      "../public",
      "../resources/views",
      "../routes",
      "../vendor",
      "../artisan"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
